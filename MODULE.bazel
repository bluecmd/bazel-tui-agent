module(name = "bazel_tui_agent", version = "0.1.0")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_rust", version = "0.74.0")

# The terminal renderer is a Rust cdylib embedded in the agent jar.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.86.0"],
    # rules_rust asks gcc for lld, and gcc finds linkers only via PATH, which
    # rustc link actions run without. Use the system bfd linker by prefix.
    extra_exec_rustc_flags = ["-Clink-arg=-fuse-ld=bfd", "-Clink-arg=-B/usr/bin"],
    extra_rustc_flags = ["-Clink-arg=-fuse-ld=bfd", "-Clink-arg=-B/usr/bin"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The crates the Rust code uses, resolved by crate_universe from these specs; the pin is
# rust/Cargo.Bazel.lock (refresh with `CARGO_BAZEL_REPIN=1 bazel build //rust:all`).
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(package = "jni", version = "0.21")
crate.spec(package = "libc", version = "0.2")
crate.spec(package = "ratatui", version = "0.29", default_features = False)
crate.spec(package = "serde", version = "1", features = ["derive"])
crate.spec(package = "serde_json", version = "1")
crate.spec(package = "unicode-width", version = "0.2")
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//rust:Cargo.Bazel.lock",
)
use_repo(crate, "crates")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = ["net.bytebuddy:byte-buddy:1.18.14"],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")

# The agent is compiled against the server jar (A-server.jar) of the Bazel
# release in .bazelversion, extracted from that release's binary. The jar it
# produces runs on Bazel 6.6 through 9.3 (see README).
bazel_server_jar = use_repo_rule("//bazel:server_jar.bzl", "bazel_server_jar")

bazel_server_jar(
    name = "bazel_server",
    version_file = "//:.bazelversion",
)
